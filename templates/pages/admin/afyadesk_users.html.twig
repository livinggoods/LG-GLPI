<div class="afyadesk-users-shell">
    <section class="afyadesk-users-topbar">
        <div class="afyadesk-users-brand">
            <img src="{{ path('/pics/logos/livinggoods-logo-white.png') }}" alt="LivingGoods">
            <h1>{{ __('User Management') }}</h1>
            <span>{{ __('Hello') }} {{ logged_user_name }}</span>
        </div>
        <div class="afyadesk-users-nav">
            <a href="{{ path('/front/central.php') }}">{{ __('AfyaDesk Menu') }}</a>
            <a href="{{ path('/front/logout.php') }}">{{ __('Sign Out') }}</a>
        </div>
    </section>

    <main class="afyadesk-users-main">
        <section class="afyadesk-users-hero">
            <div class="afyadesk-users-hero-copy">
                <span class="afyadesk-users-eyebrow">{{ __('AfyaDesk access control') }}</span>
                <h2>{{ __('Manage service-area users without leaving GLPI') }}</h2>
                <p>{{ __('Create accounts, assign AfyaDesk access levels, and review user coverage by county, sub county, ward, or community health unit.') }}</p>
            </div>
            <div class="afyadesk-users-kpis">
                <div class="afyadesk-users-kpi">
                    <span>{{ __('Users') }}</span>
                    <strong>{{ total }}</strong>
                </div>
                <div class="afyadesk-users-kpi">
                    <span>{{ __('Page') }}</span>
                    <strong>{{ page }}</strong>
                </div>
                <div class="afyadesk-users-kpi">
                    <span>{{ __('Views') }}</span>
                    <strong>{{ pages }}</strong>
                </div>
            </div>
        </section>

        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}
        {% if message %}
            <div class="alert alert-success">{{ message }}</div>
        {% endif %}

        <section class="afyadesk-users-card afyadesk-add-card">
            <div class="afyadesk-card-heading">
                <div>
                    <h2>{{ __('Add User') }}</h2>
                    <p>{{ __('Assign the first profile and service area for a new account.') }}</p>
                </div>
                <a class="btn btn-outline-secondary" href="{{ path('/front/afyadesk.user_import.php') }}">
                    <i class="ti ti-file-spreadsheet"></i>
                    {{ __('Bulk import') }}
                </a>
            </div>
            <form method="post" data-submit-once>
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <div class="afyadesk-users-form-grid">
                    <label class="afyadesk-field-main">
                        <span>{{ __('Email / Username') }}</span>
                        <input type="text" name="login" placeholder="user@example.com" required>
                        <small>{{ __('Living Goods staff (@livinggoods.org) can be managed here with the correct access level.') }}</small>
                    </label>
                    <label class="afyadesk-field-main">
                        <span>{{ __('Display Name') }}</span>
                        <input type="text" name="display_name" placeholder="John Doe">
                    </label>
                    <label class="afyadesk-field-main">
                        <span>{{ __('Access Level') }}</span>
                        <select name="profiles_id" required>
                            <option value="">{{ __('-- Select access level --') }}</option>
                            {% for profile in profiles %}
                                <option value="{{ profile.id }}">{{ profile.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <input type="hidden" name="entities_id" data-afyadesk-selected-entity>
                    <div class="afyadesk-service-grid" aria-label="{{ __('Service area') }}">
                        <label class="afyadesk-service-field">
                            <span>{{ __('County') }}</span>
                            <select data-afyadesk-area-select="0" required>
                                <option value="">{{ __('-- Select county --') }}</option>
                            </select>
                        </label>
                        <label class="afyadesk-service-field">
                            <span>{{ __('Sub County') }}</span>
                            <select data-afyadesk-area-select="1" disabled>
                                <option value="">{{ __('-- Select sub county --') }}</option>
                            </select>
                        </label>
                        <label class="afyadesk-service-field">
                            <span>{{ __('Ward') }}</span>
                            <select data-afyadesk-area-select="2" disabled>
                                <option value="">{{ __('-- Select ward --') }}</option>
                            </select>
                        </label>
                        <label class="afyadesk-service-field">
                            <span>{{ __('Community Unit') }}</span>
                            <select data-afyadesk-area-select="3" disabled>
                                <option value="">{{ __('-- Select community unit --') }}</option>
                            </select>
                        </label>
                        <small>{{ __('Choose the lowest service area this user should manage. Lower-level access is included by default.') }}</small>
                    </div>
                    <label class="afyadesk-password-field">
                        <span>{{ __('Password (for non-SSO users)') }}</span>
                        <input type="password" name="password" placeholder="Leave empty for setup email">
                    </label>
                </div>
                <div class="afyadesk-users-actions">
                    <button class="btn btn-primary" type="submit">{{ __('Add User') }}</button>
                </div>
            </form>
        </section>

        <section class="afyadesk-users-card">
            <div class="afyadesk-managed-header">
                <h2>{{ __('Managed Users') }} <span>({{ total }})</span></h2>
            </div>
            <div class="afyadesk-managed-body">
                <form method="get" class="afyadesk-managed-search">
                    <input type="search" name="q" value="{{ query }}" placeholder="{{ __('Search by email, name, or service area...') }}">
                </form>
                <div class="afyadesk-managed-table">
                    <div class="afyadesk-managed-row afyadesk-managed-head">
                        <span>{{ __('Email / Username') }}</span>
                        <span>{{ __('Name') }}</span>
                        <span>{{ __('Access') }}</span>
                        <span>{{ __('Entities') }}</span>
                        <span>{{ __('Auth') }}</span>
                        <span></span>
                    </div>
                    {% for user in users %}
                        <div class="afyadesk-managed-row">
                            <strong>{{ user.login }}</strong>
                            <span>{{ user.name ?: '-' }}</span>
                            <span class="afyadesk-chip-stack">
                                {% for profile in user.profiles %}
                                    <span class="afyadesk-access-chip">{{ profile|replace({'AfyaDesk ': '', 'Community Unit User': 'CU', 'County Admin': 'County', 'Sub County Admin': 'Subcounty', 'Ward Supervisor': 'Ward'}) }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endfor %}
                            </span>
                            <span class="afyadesk-chip-stack">
                                {% for area in user.service_areas %}
                                    <span class="afyadesk-entity-chip">{{ area|split(' > ')|last }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endfor %}
                            </span>
                            <span>{{ user.auth }}</span>
                            <span class="afyadesk-row-actions">
                                <a href="{{ path('/front/user.form.php?id=' ~ user.id) }}">{{ __('Edit') }}</a>
                                <a class="is-warning" href="{{ path('/front/user.form.php?id=' ~ user.id) }}">{{ __('Reset PW') }}</a>
                            </span>
                        </div>
                    {% else %}
                        <div class="afyadesk-managed-empty">{{ __('No users found.') }}</div>
                    {% endfor %}
                </div>

                <div class="afyadesk-managed-pagination">
                    {% if page > 1 %}
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('/front/afyadesk.users.php?page=' ~ (page - 1) ~ '&q=' ~ query|url_encode) }}">{{ __('Previous') }}</a>
                    {% else %}
                        <button class="btn btn-outline-secondary btn-sm" disabled>{{ __('Previous') }}</button>
                    {% endif %}
                    <span>{{ __('Page') }} {{ page }} {{ __('of') }} {{ pages }} ({{ total }} {{ __('users') }})</span>
                    {% if page < pages %}
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('/front/afyadesk.users.php?page=' ~ (page + 1) ~ '&q=' ~ query|url_encode) }}">{{ __('Next') }}</a>
                    {% else %}
                        <button class="btn btn-outline-secondary btn-sm" disabled>{{ __('Next') }}</button>
                    {% endif %}
                </div>
            </div>
        </section>

        <p class="afyadesk-users-footnote">{{ __('Changes are logged. Contact your administrator for full access or to remove users.') }}</p>
    </main>
</div>
<script type="application/json" id="afyadesk-entities-data">[
{% for entity in entities %}
    {"id":{{ entity.id }},"name":{{ entity.completename|replace({'Root entity > ': ''})|json_encode|raw }}}{% if not loop.last %},{% endif %}
{% endfor %}
]</script>
<script>
    (function () {
        const dataNode = document.getElementById('afyadesk-entities-data');
        const selectedEntity = document.querySelector('[data-afyadesk-selected-entity]');
        const selects = Array.from(document.querySelectorAll('[data-afyadesk-area-select]'))
            .sort((a, b) => Number(a.dataset.afyadeskAreaSelect) - Number(b.dataset.afyadeskAreaSelect));

        if (!dataNode || !selectedEntity || selects.length === 0) {
            return;
        }

        const placeholders = [
            '{{ __('-- Select county --')|e('js') }}',
            '{{ __('-- Select sub county --')|e('js') }}',
            '{{ __('-- Select ward --')|e('js') }}',
            '{{ __('-- Select community unit --')|e('js') }}'
        ];

        let entities = [];
        try {
            entities = JSON.parse(dataNode.textContent || '[]')
                .map((entity) => ({
                    id: String(entity.id),
                    name: String(entity.name || ''),
                    parts: String(entity.name || '').split(' > ').map((part) => part.trim()).filter(Boolean)
                }))
                .filter((entity) => entity.id && entity.parts.length > 0);
        } catch (error) {
            entities = [];
        }

        function selectedParts(untilIndex) {
            return selects.slice(0, untilIndex).map((select) => select.value).filter(Boolean);
        }

        function matchesPrefix(entity, prefix) {
            return prefix.every((part, index) => entity.parts[index] === part);
        }

        function entityFor(parts) {
            return entities.find((entity) => entity.parts.length === parts.length && matchesPrefix(entity, parts));
        }

        function addPlaceholder(select, index) {
            const option = document.createElement('option');
            option.value = '';
            option.textContent = placeholders[index] || '{{ __('-- Select --')|e('js') }}';
            select.appendChild(option);
        }

        function fillSelect(index) {
            const select = selects[index];
            const previousValue = select.value;
            const prefix = selectedParts(index);
            const values = [];

            select.innerHTML = '';
            addPlaceholder(select, index);

            if (index > 0 && prefix.length < index) {
                select.disabled = true;
                return;
            }

            entities.forEach((entity) => {
                const value = entity.parts[index];
                if (value && matchesPrefix(entity, prefix) && !values.includes(value)) {
                    values.push(value);
                }
            });

            values.sort((a, b) => a.localeCompare(b)).forEach((value) => {
                const option = document.createElement('option');
                option.value = value;
                option.textContent = value;
                select.appendChild(option);
            });

            select.disabled = values.length === 0;
            if (values.includes(previousValue)) {
                select.value = previousValue;
            }
        }

        function syncFrom(changedIndex) {
            for (let index = changedIndex + 1; index < selects.length; index++) {
                selects[index].value = '';
            }

            selects.forEach((select, index) => fillSelect(index));

            let parts = [];
            selects.forEach((select) => {
                const expectedIndex = Number(select.dataset.afyadeskAreaSelect);
                if (select.value && parts.length === expectedIndex) {
                    parts.push(select.value);
                }
            });

            while (parts.length > 0 && !entityFor(parts)) {
                parts = parts.slice(0, -1);
            }

            const entity = entityFor(parts);
            selectedEntity.value = entity ? entity.id : '';
        }

        selects.forEach((select, index) => {
            select.addEventListener('change', () => syncFrom(index));
        });

        fillSelect(0);
        syncFrom(0);
    }());
</script>
